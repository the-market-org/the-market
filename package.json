{
  "name": "the-market",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "db": "node --env-file-if-exists=.env scripts/run-prisma.ts",
    "generate": "pnpm --filter \"./modules/*\" exec prisma generate --schema prisma/schema.prisma",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.module-roles --watch apps/server/src/main.ts",
    "typecheck": "pnpm generate && tsc --noEmit -p tsconfig.json",
    "test": "pnpm generate && node --test \"packages/**/*.test.ts\" \"modules/**/*.test.ts\" \"apps/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.module-roles scripts/seed.ts",
    "create-store": "node scripts/create-store.ts",
    "example-agent": "node apps/example-agent/src/main.ts",
    "example-app": "node apps/example-app/src/main.ts",
    "simulate-visitors": "node scripts/simulate-visitors.ts"
  },
  "devDependencies": {
    "@the-market/core": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}

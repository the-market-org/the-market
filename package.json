{
  "name": "the-market",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "db": "node --env-file-if-exists=.env scripts/run-prisma.ts",
    "dev": "node --watch apps/server/src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"packages/**/*.test.ts\" \"modules/**/*.test.ts\" \"apps/**/*.test.ts\""
  },
  "devDependencies": {
    "@the-market/core": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}

// The catalog module's own schema. Run Prisma through `pnpm db catalog ...`,
// which points MODULE_DATABASE_URL at the "catalog" PostgreSQL schema.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("MODULE_DATABASE_URL")
}

model Product {
  productId   String    @id @default(uuid()) @map("product_id") @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  handle      String
  title       String
  description String    @default("")
  status      String    @default("draft") // draft | active | archived
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  variants    Variant[]

  @@unique([tenantId, handle])
  @@index([tenantId])
  @@map("products")
}

model Variant {
  variantId    String  @id @default(uuid()) @map("variant_id") @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  sku          String
  title        String
  priceMinor   Int     @map("price_minor")
  currencyCode String  @map("currency_code")
  product      Product @relation(fields: [productId], references: [productId])

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("variants")
}
